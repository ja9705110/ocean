# 複製此檔為 .env.local 後填入實際值。.env.local 不會進版控。
#
# Supabase 專案設定頁 → Project Settings → API 可取得下列兩個值。
# 這兩個值會被 Next.js 在建置階段內嵌進前端 bundle，屬於公開資訊，
# 安全性由資料庫的 RLS 政策負責，不是靠隱藏 key。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 下列變數目前尚未使用，預計於 M6 主持人端導入。
# service role key 可繞過所有 RLS，只能存在於伺服器端環境變數，
# 絕對不可加上 NEXT_PUBLIC_ 前綴，也絕對不可寫入版控。
# SUPABASE_SERVICE_ROLE_KEY=
