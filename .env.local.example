# 複製此檔為 .env.local 後填入實際值。.env.local 不會進版控。
#
# Supabase 專案設定頁 → Project Settings → API 可取得下列兩個值。
# 這兩個值會被 Next.js 在建置階段內嵌進前端 bundle，屬於公開資訊，
# 安全性由資料庫的 RLS 政策負責，不是靠隱藏 key。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 所有 QR Code 要指向的正式網域，例如 https://your-app.vercel.app
#
# 桌卡是活動前印的。如果印的當下後台開的是 Vercel 的預覽網址
# （每推一次分支就會產生一個 ...-git-xxx.vercel.app）或是 localhost，
# 印出來的 QR 就會指到那個網址——而預覽網址預設是受保護的，
# 掃進去看到的是「請登入」，不是入座畫面。
#
# 設了這一項，不管後台開在哪，產出來的 QR 都指向正式站。
# 留白則沿用目前瀏覽器所在的網域。
NEXT_PUBLIC_SITE_URL=

# 下列變數目前尚未使用，預計於 M6 主持人端導入。
# service role key 可繞過所有 RLS，只能存在於伺服器端環境變數，
# 絕對不可加上 NEXT_PUBLIC_ 前綴，也絕對不可寫入版控。
# SUPABASE_SERVICE_ROLE_KEY=
